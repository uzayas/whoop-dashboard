# Kopiere diese Datei nach .env.local (lokal) bzw. trage die Werte
# als GitHub "Repository variables" ein (Settings → Secrets and variables → Actions → Variables).
# Ohne diese Werte läuft die App im Demo-Modus.

# Client ID aus dem WHOOP Developer Dashboard (ist öffentlich, kein Geheimnis)
VITE_WHOOP_CLIENT_ID=
# URL deines Cloudflare Workers (siehe /worker), z. B. https://whoop-proxy.<name>.workers.dev
VITE_PROXY_URL=
